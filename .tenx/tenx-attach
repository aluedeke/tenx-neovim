#!/bin/sh
# Wait for tenxd to mark itself ready. The marker is written after the
# repo clone completes and zellij-launcher is spawned — without this,
# tenx-attach would give up before the session exists on a cold start.
i=0
while [ "$i" -lt 120 ] && [ ! -f /run/tenxd/ready ]; do
    sleep 0.5
    i=$((i + 1))
done

# Attach to the running zellij session, retrying briefly in case the
# session is still initializing after the ready marker appears.
i=0
while [ "$i" -lt 20 ]; do
    zellij --config /etc/zellij/config.kdl attach tenx && exit 0
    i=$((i + 1))
    sleep 0.25
done
exec zellij --config /etc/zellij/config.kdl attach tenx
