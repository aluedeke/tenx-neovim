# Generic TypeScript + zellij + neovim companion.
#
# Set repo = "https://github.com/you/your-repo.git" to hardwire a workspace,
# or leave it unset and pass --repo / --branch at spawn time.

command = ["zellij-launcher"]

[vm]
memory = "2gb"

[secrets]
forward = ["CLAUDE_CODE_OAUTH_TOKEN", "GH_TOKEN"]

[build]
dockerfile = ".tenx/Dockerfile.claude"
context    = ".tenx"

[docker]
# Mount the host Docker socket so the agent can run docker commands.
mounts = ["/var/run/docker.sock:/var/run/docker.sock"]
